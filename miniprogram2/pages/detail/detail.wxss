/* pages/detail/detail.wxss — 详情页样式 */
.record-meta { margin-bottom: 16rpx; }

.result-img {
  width: 100%;
  border-radius: 8rpx;
  background-color: #C8E6C9;
  margin-bottom: 16rpx;
}

.section-title {
  color: #1B5E20;
  font-size: 30rpx;
  font-weight: bold;
  margin: 16rpx 0 12rpx;
}

.det-item {
  display: flex;
  justify-content: space-between;
  background-color: #F1F8E9;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 8rpx;
}
.det-name { color: #1B5E20; font-weight: bold; font-size: 26rpx; }
.det-conf { color: #2E7D32; font-size: 24rpx; }

.advice-tip { color: #2E7D32; font-size: 26rpx; margin-bottom: 8rpx; }
.advice-source { color: #888; font-size: 24rpx; margin-bottom: 8rpx; }

/* 建议正文（智能体返回的多行文本） */
.advice-text {
  background-color: #F1F8E9;
  border-left: 8rpx solid #A5D6A7;
  border-radius: 8rpx;
  padding: 20rpx;
  color: #1B5E20;
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  margin-bottom: 8rpx;
}

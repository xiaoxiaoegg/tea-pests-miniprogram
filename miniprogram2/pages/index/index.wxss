/* pages/index/index.wxss — 首页样式（茶绿色系，对标网页端） */
.subtitle {
  color: #2E7D32;
  font-size: 26rpx;
  padding: 0 32rpx 8rpx;
}

.section-title {
  color: #1B5E20;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

/* 检测来源切换（对应网页端 .tabs / .tab） */
.tabs { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background-color: #C8E6C9;
  color: #1B5E20;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.tab.active { background-color: #A5D6A7; font-weight: bold; }

/* 预览区（对应网页端 #C8E6C9 预览面板） */
.preview {
  background-color: #C8E6C9;
  border-radius: 12rpx;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.preview-img { width: 100%; height: 100%; }
.preview-empty .preview-tip { color: #1B5E20; font-size: 26rpx; }

/* 单条检测结果 */
.det-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #F1F8E9;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 8rpx;
}
.det-name { color: #1B5E20; font-weight: bold; font-size: 26rpx; }
.det-conf { color: #2E7D32; font-size: 24rpx; }

/* 结果标注图 / 视频 */
.result-img {
  width: 100%;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  background-color: #C8E6C9;
}

.result-summary { margin-bottom: 12rpx; }

/* 危害等级徽章（与网页端 .severity-badge 同色系） */
.sev-badge {
  display: inline-block;
  padding: 6rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}
.sev-none { background-color: #9E9E9E; }
.sev-light { background-color: #4CAF50; }
.sev-mid { background-color: #FF9800; }
.sev-heavy { background-color: #E53935; }

/* 复拍按钮（深青绿，区别于主按钮） */
.retest-btn {
  background-color: #00695C;
  color: #ffffff;
  border-color: #00695C;
}

.tip { color: #81C784; font-size: 22rpx; line-height: 1.6; margin-top: 12rpx; }

/* 错误卡片 */
.error-card { border-left: 8rpx solid #C62828; }
.error-text { color: #C62828; font-weight: bold; }
.error-tips { display: flex; flex-direction: column; margin-top: 8rpx; color: #666; font-size: 24rpx; }

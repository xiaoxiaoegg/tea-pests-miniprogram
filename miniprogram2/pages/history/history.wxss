/* pages/history/history.wxss — 记录列表样式 */
.subtitle {
  color: #2E7D32;
  font-size: 26rpx;
  padding: 0 32rpx 8rpx;
}

.record-card { padding: 20rpx 24rpx; }

.record-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.record-id { color: #1B5E20; font-weight: bold; }
.record-time { color: #888; font-size: 24rpx; }

.record-body { display: flex; align-items: center; }
.record-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  background-color: #C8E6C9;
  flex-shrink: 0;
}
.record-info {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 140rpx;
  flex: 1;
}
.advice-state { color: #888; font-size: 24rpx; }
.advice-state.done { color: #2E7D32; }

.refresh-btn { margin: 20rpx; }
